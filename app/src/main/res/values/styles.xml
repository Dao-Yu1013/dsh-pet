<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DshPet" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07090F</item>
        <item name="android:colorAccent">#7C5CFF</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#07090F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 图片选择中转页：完全透明，不打扰当前界面 -->
    <style name="Theme.DshPet.Pick" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
